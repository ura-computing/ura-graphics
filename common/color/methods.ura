pub fn create(r u8, g u8, b u8, a u8) Color:
    return {
        r: r,
        g: g,
        b: b,
        a: a
    }

fn packed() u32:
    red u32 = self.r as u32
    green u32 = (self.g as u32) << 8
    blue u32 = (self.b as u32) << 16
    alpha u32 = (self.a as u32) << 24
    return red | green | blue | alpha
