pub fn create(title String, width i32, height i32) Window:
    if SDL2::SDL_Init(SDL2::SDL_INIT_VIDEO) != 0:
        throw sdl_error("SDL_Init")
    handle i8[] = SDL2::SDL_CreateWindow(
        title.chars(),
        SDL2::SDL_WINDOWPOS_CENTERED,
        SDL2::SDL_WINDOWPOS_CENTERED,
        width,
        height,
        SDL2::SDL_WINDOW_OPENGL | SDL2::SDL_WINDOW_SHOWN
    )
    if handle == null:
        throw sdl_error("SDL_CreateWindow")
    context i8[] = SDL2::SDL_GL_CreateContext(handle)
    if context == null:
        throw sdl_error("SDL_GL_CreateContext")

    texture u32 = 0
    OpenGL::glGenTextures(1, &texture)
    OpenGL::glBindTexture(OpenGL::GL_TEXTURE_2D, texture)
    OpenGL::glTexParameteri(OpenGL::GL_TEXTURE_2D, OpenGL::GL_TEXTURE_MIN_FILTER, OpenGL::GL_NEAREST)
    OpenGL::glTexParameteri(OpenGL::GL_TEXTURE_2D, OpenGL::GL_TEXTURE_MAG_FILTER, OpenGL::GL_NEAREST)
    OpenGL::glTexImage2D(
        OpenGL::GL_TEXTURE_2D,
        0,
        OpenGL::GL_RGBA as i32,
        width,
        height,
        0,
        OpenGL::GL_RGBA,
        OpenGL::GL_UNSIGNED_BYTE,
        null
    )
    OpenGL::glEnable(OpenGL::GL_TEXTURE_2D)
    OpenGL::glViewport(0, 0, width, height)
    OpenGL::glMatrixMode(OpenGL::GL_PROJECTION)
    OpenGL::glLoadIdentity()
    OpenGL::glOrtho(0.0, width as f64, height as f64, 0.0, -1.0, 1.0)
    OpenGL::glMatrixMode(OpenGL::GL_MODELVIEW)
    OpenGL::glLoadIdentity()
    if OpenGL::glGetError() != 0:
        throw Error::create("OpenGL: can't set up the texture")
    return {
        handle: handle,
        context: context,
        texture: texture,
        width: width,
        height: height,
        open: True
    }

fn is_open() bool:
    return self.open

fn close():
    self.open = False

fn poll(event &Event) bool:
    if not sdl_poll(&event):
        return False
    if event.kind == EventKind::QUIT:
        self.open = False
    return True

fn draw(pixels &Array<Color>):
    if pixels.len() != self.width * self.height:
        throw Error::create($"draw: {pixels.len()} pixels for a {self.width}x{self.height} window")
    right f32 = self.width as f32
    bottom f32 = self.height as f32
    OpenGL::glBindTexture(OpenGL::GL_TEXTURE_2D, self.texture)
    OpenGL::glTexSubImage2D(
        OpenGL::GL_TEXTURE_2D,
        0,
        0,
        0,
        self.width,
        self.height,
        OpenGL::GL_RGBA,
        OpenGL::GL_UNSIGNED_BYTE,
        pixels.data as i8[]
    )
    OpenGL::glClear(OpenGL::GL_COLOR_BUFFER_BIT)
    OpenGL::glBegin(OpenGL::GL_QUADS)
    OpenGL::glTexCoord2f(0.0f, 0.0f)
    OpenGL::glVertex2f(0.0f, 0.0f)
    OpenGL::glTexCoord2f(1.0f, 0.0f)
    OpenGL::glVertex2f(right, 0.0f)
    OpenGL::glTexCoord2f(1.0f, 1.0f)
    OpenGL::glVertex2f(right, bottom)
    OpenGL::glTexCoord2f(0.0f, 1.0f)
    OpenGL::glVertex2f(0.0f, bottom)
    OpenGL::glEnd()
    if OpenGL::glGetError() != 0:
        throw Error::create("OpenGL: can't draw the pixels")

fn present():
    SDL2::SDL_GL_SwapWindow(self.handle)

fn set_title(title String):
    SDL2::SDL_SetWindowTitle(self.handle, title.chars())
